#!/bin/bash

# Pre-commit hook: blocks commits containing secret-like patterns or oversized files

BLOCKED=0
MAX_SIZE_BYTES=1048576  # 1MB

echo "Running pre-commit checks..."

# Get list of staged files (added, copied, modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_FILES; do
  # Skip if file doesn't exist (e.g., was deleted)
  [ -f "$FILE" ] || continue

  # Check file size
  FILE_SIZE=$(stat -c%s "$FILE" 2>/dev/null || stat -f%z "$FILE" 2>/dev/null)
  if [ "$FILE_SIZE" -gt "$MAX_SIZE_BYTES" ]; then
    echo "BLOCKED: $FILE is larger than 1MB ($FILE_SIZE bytes)."
    BLOCKED=1
  fi

  # Check for secret-like patterns
  if grep -E "AKIA[0-9A-Z]{16}" "$FILE" > /dev/null 2>&1; then
    echo "BLOCKED: $FILE contains a pattern matching an AWS access key (AKIA...)."
    BLOCKED=1
  fi

  if grep -E "(PASSWORD|SECRET|API_KEY)[[:space:]]*=[[:space:]]*[\"'][^\"']+[\"']" "$FILE" > /dev/null 2>&1; then
    echo "BLOCKED: $FILE contains a hardcoded password/secret/API key pattern."
    BLOCKED=1
  fi
done

if [ "$BLOCKED" -eq 1 ]; then
  echo ""
  echo "Commit rejected. Remove secrets and oversized files before committing."
  exit 1
fi

echo "Pre-commit checks passed."
exit 0
